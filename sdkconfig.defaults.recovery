# Recovery ("BL-A429-ESP_4D") build overrides, applied on top of
# sdkconfig.defaults. The personality switch itself is the RECOVERY_BUILD
# compile definition (see the top-level CMakeLists.txt); no Kconfig
# differences are required today. Keep the recovery app lean: quieter
# default log level saves a little flash and boot time.

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Recovery keeps USB-Serial-JTAG as a secondary bench console: no TinyUSB is
# installed in this personality. The primary UART console remains disabled,
# leaving UART0 exclusively available to RS-485 in both personalities.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=n
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_TINYUSB_HID_COUNT=0
