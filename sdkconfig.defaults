# ESP32-S3 ARINC429 linecard — shared defaults (application build).

CONFIG_IDF_TARGET="esp32s3"

# Waveshare ESP32-S3-ETH: 8 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Custom partition table: factory = recovery app, ota_0 = main app.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# W5500 over SPI.
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# A freshly OTA'd app must mark itself valid (done once the control server
# is up) or the bootloader rolls back — a crash-looping image auto-reverts
# to the factory recovery app without user action.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The second-stage bootloader must not transmit diagnostics on UART0 before
# the application configures it as the RS-485 Modbus port.
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# 1 ms tick for the protocol timing services.
CONFIG_FREERTOS_HZ=1000

# Runtime logs are carried by the AES gateway wire protocol over Ethernet.
# Keep the primary console disabled so UART0 (TX GPIO43, RX GPIO44) belongs
# exclusively to the external RS-485 bus. The application also disables the
# USB-Serial-JTAG secondary console because TinyUSB HID owns the USB PHY.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# esp_tinyusb: one HID interface, no CDC/MSC.
CONFIG_TINYUSB_HID_COUNT=1
